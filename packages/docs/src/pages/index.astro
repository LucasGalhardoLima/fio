---
// Custom landing page — not managed by Starlight
import '../styles/landing.css'
import { Code } from 'astro:components'
import githubDark from 'shiki/themes/github-dark.mjs'

const heroCode = `import { Fio } from '@fio-pay/sdk'

const fio = new Fio({ apiKey: 'fio_test_...' })

const sub = await fio.subscriptions.create({
  customer_id: 'cus_abc123',
  plan_id: 'plan_xyz789',
})

console.log(sub.status) // "trialing"`

const fullCode = `import { Fio } from '@fio-pay/sdk'

const fio = new Fio({ apiKey: 'fio_test_sua_chave' })

// 1. Crie um cliente
const customer = await fio.customers.create({
  name: 'João Silva',
  email: 'joao@example.com',
  tax_id: '52998224725',
  tax_id_type: 'cpf',
})

// 2. Gere uma cobrança PIX
const charge = await fio.charges.create({
  customer_id: customer.id,
  amount: 4990, // R$ 49,90
  expires_in: 3600,
})

console.log(charge.pix_qr_code) // Copia-e-cola do PIX

// 3. (Sandbox) Simule o pagamento
await fio.test.simulatePayment(charge.id)

const paid = await fio.charges.get(charge.id)
console.log(paid.status) // "paid" ✅`
---
<html lang="pt-BR" class="dark">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Fio — Cobrança recorrente via PIX pra devs</title>
  <meta name="description" content="Integre assinaturas PIX no seu SaaS em minutos. SDK TypeScript, webhooks, sandbox completo." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Fio — Cobrança recorrente via PIX pra devs" />
  <meta property="og:description" content="Integre assinaturas PIX no seu SaaS em minutos. SDK TypeScript, webhooks, sandbox completo." />
  <meta property="og:image" content="https://fiopay-docs.vercel.app/og-image.png" />
  <meta property="og:url" content="https://fiopay-docs.vercel.app/" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Fio — Cobrança recorrente via PIX pra devs" />
  <meta name="twitter:description" content="Integre assinaturas PIX no seu SaaS em minutos." />
  <meta name="twitter:image" content="https://fiopay-docs.vercel.app/og-image.png" />
</head>
<body class="bg-[#030712] text-gray-100 antialiased">

  <!-- Nav -->
  <nav class="nav-sticky" id="main-nav">
    <div class="max-w-6xl mx-auto flex items-center justify-between px-6 py-4">
      <a href="/" class="text-xl font-bold text-white tracking-tight relative z-[60]">Fio</a>

      <button class="hamburger" id="menu-toggle" aria-label="Abrir menu">
        <span></span>
        <span></span>
        <span></span>
      </button>

      <div class="nav-links" id="nav-links">
        <a href="/docs/" class="text-gray-400 hover:text-white transition-colors text-sm">Docs</a>
        <a href="#pricing" class="text-gray-400 hover:text-white transition-colors text-sm">Precos</a>
        <a href="https://github.com/LucasGalhardoLima/fio" target="_blank" rel="noopener" class="text-gray-400 hover:text-white transition-colors text-sm">GitHub</a>
        <a href="/docs/quickstart/" class="btn-primary text-sm !py-2 !px-4">Comece agora</a>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="hero-glow"></div>
    <div class="max-w-6xl mx-auto px-6 pt-24 pb-32 relative z-10">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div class="reveal">
          <div class="badge mb-6">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><circle cx="7" cy="7" r="3" fill="#22c55e"/><circle cx="7" cy="7" r="6" stroke="#22c55e" stroke-opacity="0.4" stroke-width="1"/></svg>
            Em desenvolvimento
          </div>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-[1.1] tracking-tight">
            <span class="hero-headline">Cobranca recorrente via PIX</span>
            <br />
            <span class="gradient-text">pra devs</span>
          </h1>
          <p class="mt-6 text-lg text-gray-400 leading-relaxed max-w-lg">
            Integre assinaturas PIX no seu SaaS em minutos. SDK TypeScript, webhooks, sandbox completo.
          </p>
          <div class="mt-10 flex flex-wrap gap-4">
            <a href="/docs/quickstart/" class="btn-primary">Comece agora</a>
            <a href="/docs/" class="btn-secondary">Ver docs</a>
          </div>
        </div>
        <div class="reveal code-glow">
          <Code code={heroCode} lang="typescript" theme={githubDark} />
        </div>
      </div>
    </div>
  </section>

  <div class="section-divider"></div>

  <!-- How it works -->
  <section class="max-w-6xl mx-auto px-6 py-28">
    <div class="text-center mb-16 reveal">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight">Como funciona</h2>
      <p class="mt-4 text-gray-400 max-w-xl mx-auto">Tres passos para cobrar seus clientes com PIX recorrente.</p>
    </div>
    <div class="grid md:grid-cols-3 gap-6 reveal-stagger">
      <div class="feature-card reveal">
        <div class="feature-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        </div>
        <h3 class="text-lg font-semibold mb-2 text-white">Crie planos e assinaturas</h3>
        <p class="text-gray-400 text-sm leading-relaxed">Defina preco, intervalo e periodo de trial. A API cuida do ciclo de cobranca automaticamente.</p>
      </div>
      <div class="feature-card reveal">
        <div class="feature-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
        </div>
        <h3 class="text-lg font-semibold mb-2 text-white">Receba via PIX</h3>
        <p class="text-gray-400 text-sm leading-relaxed">QR code gerado automaticamente. Pagamentos confirmados por webhook em tempo real.</p>
      </div>
      <div class="feature-card reveal">
        <div class="feature-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        </div>
        <h3 class="text-lg font-semibold mb-2 text-white">Gerencie tudo por API</h3>
        <p class="text-gray-400 text-sm leading-relaxed">Dunning automatico, pausar/cancelar/retomar assinaturas, metricas de MRR e churn.</p>
      </div>
    </div>
  </section>

  <div class="section-divider"></div>

  <!-- Code example -->
  <section class="max-w-6xl mx-auto px-6 py-28">
    <div class="text-center mb-14 reveal">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight">Sua primeira cobranca em 6 linhas</h2>
      <p class="mt-4 text-gray-400 max-w-2xl mx-auto">Do SDK instalado ao pagamento confirmado &mdash; tudo no sandbox, sem cadastro de gateway.</p>
    </div>
    <div class="max-w-3xl mx-auto reveal code-glow">
      <Code code={fullCode} lang="typescript" theme={githubDark} />
    </div>
  </section>

  <div class="section-divider"></div>

  <!-- Pricing -->
  <section id="pricing" class="max-w-6xl mx-auto px-6 py-28">
    <div class="text-center mb-14 reveal">
      <h2 class="text-3xl sm:text-4xl font-bold tracking-tight">Simples e transparente</h2>
      <p class="mt-4 text-gray-400">Sem mensalidade. Sem setup. Sem surpresa.</p>
    </div>
    <div class="max-w-md mx-auto reveal">
      <div class="pricing-card text-center">
        <div class="text-5xl sm:text-6xl font-bold gradient-text mb-2">1,49%</div>
        <div class="text-gray-400 mb-8">por cobranca PIX</div>
        <ul class="check-list text-left text-gray-300 text-sm space-y-2 mb-10">
          <li>Sandbox gratis e ilimitado</li>
          <li>Sem limite de transacoes</li>
          <li>Webhooks inclusos</li>
          <li>SDK TypeScript completo</li>
          <li>Suporte por Discord</li>
        </ul>
        <a href="/docs/quickstart/" class="btn-primary w-full">Comece agora &mdash; gratis no sandbox</a>
      </div>
    </div>
  </section>

  <div class="section-divider"></div>

  <!-- Footer -->
  <footer class="footer-gradient">
    <div class="max-w-6xl mx-auto px-6 py-20">
      <div class="text-center reveal">
        <h2 class="text-2xl sm:text-3xl font-bold mb-4 tracking-tight">Sua primeira cobranca PIX em 5 minutos</h2>
        <p class="text-gray-400 mb-8 max-w-md mx-auto">Crie sua conta no sandbox, instale o SDK e gere sua primeira cobranca.</p>
        <a href="/docs/quickstart/" class="btn-primary mb-10 inline-flex">Comece agora</a>
        <div class="flex items-center justify-center gap-8 text-sm text-gray-500 mt-10">
          <a href="/docs/" class="hover:text-gray-300 transition-colors">Docs</a>
          <a href="https://github.com/LucasGalhardoLima/fio" target="_blank" rel="noopener" class="hover:text-gray-300 transition-colors">GitHub</a>
        </div>
        <p class="text-gray-600 text-sm mt-8">&copy; 2026 Fio</p>
      </div>
    </div>
  </footer>

  <!-- Scripts: mobile nav toggle + scroll reveal + nav scroll state -->
  <script>
    // Mobile hamburger toggle
    const toggle = document.getElementById('menu-toggle');
    const nav = document.getElementById('main-nav');
    if (toggle && nav) {
      toggle.addEventListener('click', () => {
        const open = nav.getAttribute('data-menu-open') === 'true';
        nav.setAttribute('data-menu-open', open ? 'false' : 'true');
      });
      // Close menu when a nav link is clicked
      document.querySelectorAll('#nav-links a').forEach(link => {
        link.addEventListener('click', () => nav.setAttribute('data-menu-open', 'false'));
      });
    }

    // Scroll reveal via IntersectionObserver
    const reveals = document.querySelectorAll('.reveal');
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); observer.unobserve(e.target); } });
    }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
    reveals.forEach(el => observer.observe(el));

    // Nav border on scroll
    const navEl = document.getElementById('main-nav');
    if (navEl) {
      window.addEventListener('scroll', () => {
        navEl.classList.toggle('scrolled', window.scrollY > 20);
      }, { passive: true });
    }
  </script>

</body>
</html>
